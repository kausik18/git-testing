---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page Not Found | DevNotes"
	description="The page you requested could not be found on DevNotes. Browse our documentation guides and blog articles to find what you need."
	minimal
>
	<section class="prose">
		<h1>Page not found</h1>
		<p class="lead">Sorry, that page does not exist. It may have been moved or renamed.</p>
		<h2>Try one of these instead</h2>
		<ul>
			<li><a href="/">DevNotes home</a></li>
			<li><a href="/docs">Documentation guides</a></li>
			<li><a href="/blog">Blog articles</a></li>
			<li><a href="/contact">Contact the editors</a></li>
		</ul>
	</section>
</BaseLayout>
