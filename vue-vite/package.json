    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
