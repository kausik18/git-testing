{
  "name": "greenleaf-vue-vite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GreenLeaf Plant Shop - Vue 3 + Vite CSR SPA used as an SEO crawler test site",
  "scripts": {
    "gen:seo-files": "node scripts/gen-sitemap.mjs",
